;out pins are "spi" mosi for shift registers
;set pin is lcd clk
;sideset is "spi" latch and clk and shift registers
.program lcd_send_spi
.side_set 2 opt 
.wrap_target



;clear the latch

;loop 4 times for 12 bits total
set y, 3 side 0 ;clear latch and clock

;;set pins 0 side 0 
;nop side 0 ;clear latch and clock

;wait 1 irq 3 ;wait for 2nd stage to be ready

irq set 4 ;flag for when we get stalled waiting to pull a byte

;pull ; autopull is enabled this isnt needed

;send the bits to the shift buffer
buffer_target: 

;;set pins 0  ;unclock the lcd

out pins 3 side 0 [2]   ;put the bits on the "serial" out pins, clear latch and clock

irq clear 4

;;set pins 1 ;clk the lcd for the previous pixel on the current registered latch

jmp y--  buffer_target side 2 [2]  ;clock the shift registers clk on the side pins

;wait 1 irq 3    ;check ready for next pixel so we dont latch the bits before the lcd has finished with the last ones

;latch the bits through the shift registers
;set pins 1  [1]
nop side 1 [3]


;trigger lcd_send_clk
irq set 2       ;flag next pixel ready


;set y, 3 ;clock the lcd in this program

;lcd_target_inline:
;set pins 1 [1]
;set pins 0 [0]

;jmp y-- lcd_target_inline 
	
;set pins 0

;wait 1 irq 4 ;wait for last pixel to be sent

;irq set 0 ;flag current byte has been sent

.wrap



;this can also be done in the main lcd_send to save a statemachine, using 2 sideset pins for the spi clk and latch
;but by doing separately we can clock the lcd whilst the next bits are being clock through the shift registers 
;set pin is lcd clk
.program lcd_send_clk
.wrap_target

set y, 3

;irq set 3     ;ready for next pixel
wait 1 irq 2  ;waiting for next pixel
;irq clear 3  ;processing next pixel

;clock the lcd

lcd_target:
set pins 1 [2]
set pins 0 [1]

jmp y-- lcd_target [1]

;irq set 0

.wrap