;out pin is spi mosi
;set pins are shift buffer latch 
;sideset is spi clk
.program lcd_send_spi
.side_set 1 opt 
.wrap_target

;clear the latch

;loop 6 times for 12 bits total
set y, 3

set pins 0 side 0 

;pull ;autopull is enabled so this isnt needed

;send the bits to the shift buffer
buffer_target: 
 
out pins 3 side 0 [2]   ;put the bits on the "serial" out pin  
 
jmp y--  buffer_target side 1 [3]  ;clock the clk on the side pin

;wait 1 irq 1    ;check ready for next pixel so we dont latch the bits before the lcd has finished with the last ones

;latch the bits
set pins 1 

;trigger lcd_send_clk

irq set 0       ;flag next pixel ready

.wrap


;this can also be done in the main lcd_send to save a statemachine, using 2 sideset pins for the spi clk and latch
;set pin is lcd clk
.program lcd_send_clk
.wrap_target

set y, 3

;irq set 1     ;ready for next pixel
wait 1 irq 0   ;waiting for next pixel

;clock the lcd

lcd_target:
set pins 0 [2]
set pins 1 [2]

jmp y-- lcd_target 
	
set pins 0

.wrap